<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>  <!--Treat warnings as errors-->
	  
  </PropertyGroup>
	<ItemGroup>
		<Using Remove="System.Linq" /> <!--No Linq -->
	</ItemGroup>
</Project>
